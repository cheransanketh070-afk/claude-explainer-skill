{
 "meta": {
  "product": "PriceHawk",
  "theme": "dark-tech",
  "url": "github.com/you/pricehawk",
  "bg": "aurora"
 },
 "scenes": [
  {
   "type": "custom",
   "duration": 9,
   "narration": "Ask the bot to track a product, and it quietly watches it for you. When the price drops, your phone buzzes.",
   "data": {
    "heading": "Alerts that *find you*",
    "html": "\n<div class=\"u-row\" style=\"gap:80px;align-items:center\">\n  <div class=\"phone\">\n    <div class=\"bar\"><div class=\"av\">\ud83e\udd85</div>PriceHawk Bot</div>\n    <div class=\"b me m1\">/track Widget Pro</div>\n    <div class=\"b bot m2\">Tracking <b>Widget Pro</b> &middot; now $49.00</div>\n    <div class=\"typing t1\"><i></i><i></i><i></i></div>\n    <div class=\"b bot m3\">Price drop! <span class=\"drop\">$49.00 &rarr; $39.00</span> (-20%)</div>\n  </div>\n  <div class=\"side\">\n    <div class=\"u-big u-grad s1\">No dashboards<br>to <i>check</i></div>\n    <div class=\"u-lg u-muted s2\">A buzz only when<br>it matters.</div>\n  </div>\n</div>",
    "css": "\n& .phone{width:760px;border-radius:44px;background:var(--code);border:2px solid var(--border);box-shadow:var(--shadow);padding:26px 26px 30px;display:flex;flex-direction:column;gap:18px;min-height:600px}\n& .bar{display:flex;align-items:center;gap:16px;padding-bottom:16px;border-bottom:1px solid rgba(255,255,255,.1);color:#e8edff;font-weight:700;font-size:28px}\n& .av{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));display:grid;place-items:center;color:#fff}\n& .b{max-width:86%;padding:18px 24px;border-radius:24px;font-size:28px;line-height:1.35;color:#eef2ff}\n& .me{align-self:flex-end;background:var(--accent);border-bottom-right-radius:8px}\n& .bot{align-self:flex-start;background:rgba(255,255,255,.09);border-bottom-left-radius:8px}\n& .drop{color:var(--good);font-weight:800}\n& .typing{align-self:flex-start;display:flex;gap:8px;padding:20px 26px;background:rgba(255,255,255,.09);border-radius:24px}\n& .typing i{width:12px;height:12px;border-radius:50%;background:var(--muted)}\n& .side{display:flex;flex-direction:column;gap:22px;max-width:640px}\n",
    "js": "\nconst q=s=>box.querySelector(s);\nconst pop=[[q('.m1'),.6],[q('.m2'),1.9],[q('.m3'),4.4]];\npop.forEach(([e,t])=>c.a(e,[{opacity:0,transform:'translateY(24px) scale(.94)'},{opacity:1,transform:'none'}],t,.5));\nconst ty=q('.t1'); c.a(ty,[{opacity:0},{opacity:1,offset:.1},{opacity:1,offset:.9},{opacity:0}],3.0,1.3,'linear');\nty.querySelectorAll('i').forEach((d,i)=>H.loop(c,.9,3.0,u=>{d.style.transform='translateY('+(-8*Math.sin((u*2-i*.3)*Math.PI))+'px)'}));\nc.a(q('.s1'),[{opacity:0,transform:'translateX(40px)'},{opacity:1,transform:'none'}],.9,.7);\nc.a(q('.s2'),[{opacity:0,transform:'translateX(40px)'},{opacity:1,transform:'none'}],1.5,.7);\n"
   }
  },
  {
   "type": "custom",
   "duration": 9,
   "narration": "Under the hood, PriceHawk walks the page, finds the name and the price with selectors, and turns them into a clean row.",
   "data": {
    "heading": "From *page* to *row*",
    "html": "\n<div class=\"u-row\" style=\"gap:60px;align-items:center;width:100%;justify-content:center\">\n  <div class=\"u-card pg\" style=\"width:430px\"><div class=\"u-pill\" style=\"margin-bottom:18px\">shop.example/widget</div>\n    <div class=\"line l1\">Widget Pro</div><div class=\"line l2\">$39.00</div><div class=\"line l3\">In stock</div><div class=\"skel\"></div><div class=\"skel s\"></div></div>\n  <svg class=\"tree\" width=\"420\" height=\"440\" viewBox=\"0 0 420 440\" fill=\"none\" stroke-width=\"3\" stroke-linecap=\"round\">\n    <path class=\"e1\" d=\"M210 40 L110 150\" stroke=\"var(--border)\"/><path class=\"e2\" d=\"M210 40 L310 150\" stroke=\"var(--border)\"/>\n    <path class=\"e3\" d=\"M110 150 L60 270\" stroke=\"var(--border)\"/><path class=\"e4\" d=\"M110 150 L160 270\" stroke=\"var(--border)\"/>\n    <path class=\"e5\" d=\"M310 150 L310 270\" stroke=\"var(--border)\"/>\n    <g class=\"n n0\"><circle cx=\"210\" cy=\"40\" r=\"26\" fill=\"var(--card2)\" stroke=\"var(--border)\"/><text x=\"210\" y=\"46\" text-anchor=\"middle\" fill=\"var(--muted)\" font-size=\"16\" font-family=\"monospace\">div</text></g>\n    <g class=\"n n1\"><circle cx=\"110\" cy=\"150\" r=\"26\" fill=\"var(--card2)\" stroke=\"var(--border)\"/><text x=\"110\" y=\"156\" text-anchor=\"middle\" fill=\"var(--muted)\" font-size=\"16\" font-family=\"monospace\">h1</text></g>\n    <g class=\"n n2\"><circle cx=\"310\" cy=\"150\" r=\"26\" fill=\"var(--card2)\" stroke=\"var(--border)\"/><text x=\"310\" y=\"156\" text-anchor=\"middle\" fill=\"var(--muted)\" font-size=\"16\" font-family=\"monospace\">div</text></g>\n    <g class=\"n n3 hit\"><circle cx=\"60\" cy=\"270\" r=\"30\" fill=\"var(--card2)\" stroke=\"var(--accent)\"/><text x=\"60\" y=\"276\" text-anchor=\"middle\" fill=\"var(--accent2)\" font-size=\"16\" font-family=\"monospace\">.name</text></g>\n    <g class=\"n n4 hit\"><circle cx=\"160\" cy=\"270\" r=\"30\" fill=\"var(--card2)\" stroke=\"var(--accent)\"/><text x=\"160\" y=\"276\" text-anchor=\"middle\" fill=\"var(--accent2)\" font-size=\"16\" font-family=\"monospace\">.price</text></g>\n    <g class=\"n n5\"><circle cx=\"310\" cy=\"270\" r=\"26\" fill=\"var(--card2)\" stroke=\"var(--border)\"/><text x=\"310\" y=\"276\" text-anchor=\"middle\" fill=\"var(--muted)\" font-size=\"16\" font-family=\"monospace\">p</text></g>\n    <g class=\"dot\"><circle r=\"16\" fill=\"var(--accent2)\" opacity=\".3\"/><circle r=\"8\" fill=\"var(--accent2)\"/></g>\n  </svg>\n  <div class=\"u-card out u-mono\" style=\"width:400px;font-size:26px\"><div class=\"u-muted u-sm\" style=\"margin-bottom:14px\">row.json</div><div class=\"o1\">{ \"name\": \"<span class=\"u-accent2 v1\"></span>\",</div><div class=\"o2\">&nbsp; \"price\": <span class=\"u-good v2\"></span> }</div></div>\n</div>",
    "css": "\n& .line{font-size:34px;font-weight:700;margin:10px 0}& .l2{color:var(--good);font-family:var(--mono)}\n& .skel{height:16px;border-radius:8px;background:var(--border);margin-top:16px}& .skel.s{width:60%}\n",
    "js": "\nconst q=s=>box.querySelector(s), qa=s=>box.querySelectorAll(s);\nc.a(q('.pg'),[{opacity:0,transform:'translateX(-50px)'},{opacity:1,transform:'none'}],.4,.7);\nc.a(q('.tree'),[{opacity:0},{opacity:1}],1.0,.5);\n['.e1','.e2','.e3','.e4','.e5'].forEach((e,i)=>H.draw(c,q(e),1.2+i*.2,.4));\nqa('.n').forEach((n,i)=>c.a(n,[{opacity:0,transform:'scale(.5)'},{opacity:1,transform:'scale(1)'}],1.1+i*.18,.4));\nconst d1=document.createElementNS('http://www.w3.org/2000/svg','path'); d1.setAttribute('d','M210 40 L110 150 L60 270');\nconst d2=document.createElementNS('http://www.w3.org/2000/svg','path'); d2.setAttribute('d','M210 40 L110 150 L160 270');\nconst dot=q('.dot'); const fake=[d1,d2];\nH.along(c,dot,d1,2.6,1.1,{hide:true});\nconst dot2=dot.cloneNode(true); dot.parentNode.appendChild(dot2); H.along(c,dot2,d2,3.9,1.1,{hide:true});\nc.a(q('.out'),[{opacity:0,transform:'translateX(50px)'},{opacity:1,transform:'none'}],2.2,.7);\nH.type(c,q('.v1'),'Widget Pro',3.7,18,{cursor:false}); H.type(c,q('.v2'),'39.00',5.0,12,{cursor:false});\nc.a(q('.n3'),[{opacity:1},{opacity:1}],3.7,.1);\n"
   }
  },
  {
   "type": "custom",
   "duration": 9,
   "narration": "A simple API lets other tools add products and get the current price back in milliseconds.",
   "data": {
    "heading": "One call to *start tracking*",
    "html": "\n<div class=\"u-row\" style=\"gap:46px;align-items:stretch;width:100%;justify-content:center\">\n  <div class=\"u-card rq\" style=\"width:560px\"><div class=\"u-row\" style=\"margin-bottom:16px\"><span class=\"u-pill\" style=\"color:var(--accent2)\">POST</span><span class=\"u-mono u-md\">/v1/track</span></div>\n    <pre class=\"u-mono rqb\" style=\"margin:0;font-size:26px;line-height:1.55;min-height:150px;white-space:pre-wrap\"></pre></div>\n  <div class=\"u-center\" style=\"width:240px;position:relative\"><svg width=\"240\" height=\"120\" viewBox=\"0 0 240 120\" fill=\"none\"><path class=\"ln\" d=\"M10 60 H230\" stroke=\"var(--accent)\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-dasharray=\"2 12\"/><g class=\"pk\"><circle r=\"16\" fill=\"var(--accent2)\" opacity=\".3\"/><circle r=\"8\" fill=\"var(--accent2)\"/></g><g class=\"pk2\"><circle r=\"16\" fill=\"var(--good)\" opacity=\".3\"/><circle r=\"8\" fill=\"var(--good)\"/></g></svg>\n    <div class=\"u-pill srv\" style=\"position:absolute;top:-34px;left:50%;transform:translateX(-50%)\">api.pricehawk</div></div>\n  <div class=\"u-card rs\" style=\"width:560px\"><div class=\"u-row\" style=\"margin-bottom:16px\"><span class=\"u-pill st\" style=\"color:var(--good)\">200 OK</span><span class=\"u-mono u-md u-muted tm\"></span></div>\n    <pre class=\"u-mono rsb\" style=\"margin:0;font-size:26px;line-height:1.55;min-height:150px;white-space:pre-wrap\"></pre></div>\n</div>",
    "js": "\nconst q=s=>box.querySelector(s);\nc.a(q('.rq'),[{opacity:0,transform:'translateX(-40px)'},{opacity:1,transform:'none'}],.4,.6);\nc.a(q('.rs'),[{opacity:0,transform:'translateX(40px)'},{opacity:1,transform:'none'}],.4,.6);\nconst t1=H.type(c,q('.rqb'),'{\\n  \"url\": \"shop.example/widget\",\\n  \"notify\": \"telegram\"\\n}',1.0,40);\nconst path=document.createElementNS('http://www.w3.org/2000/svg','path'); path.setAttribute('d','M10 60 H230');\nconst path2=document.createElementNS('http://www.w3.org/2000/svg','path'); path2.setAttribute('d','M230 60 H10');\nH.along(c,q('.pk'),path,t1+.2,.9,{hide:true});\nc.a(q('.st'),[{opacity:0},{opacity:1}],t1+1.2,.3);\nH.type(c,q('.rsb'),'{\\n  \"id\": \"trk_9f2\",\\n  \"price\": 49.0,\\n  \"status\": \"watching\"\\n}',t1+1.4,40);\nH.count(c,q('.tm'),42,t1+1.2,.6,{suffix:' ms'});\nH.along(c,q('.pk2'),path2,t1+1.1,.9,{hide:true});\n"
   }
  },
  {
   "type": "custom",
   "duration": 9,
   "narration": "The dashboard shows what's being watched, how many checks ran today, and every price drop it caught.",
   "data": {
    "heading": "Everything at a *glance*",
    "html": "\n<div class=\"u-col\" style=\"width:100%;gap:34px\">\n  <div class=\"u-grid\" style=\"grid-template-columns:repeat(3,1fr)\">\n    <div class=\"u-card k1\"><div class=\"u-muted u-md\">Products watched</div><div class=\"u-big v1\">0</div></div>\n    <div class=\"u-card k2\"><div class=\"u-muted u-md\">Checks today</div><div class=\"u-big v2\">0</div></div>\n    <div class=\"u-card k3\"><div class=\"u-muted u-md\">Price drops caught</div><div class=\"u-big u-good v3\">0</div></div>\n  </div>\n  <div class=\"u-card ch\" style=\"padding:30px 36px\"><div class=\"u-muted u-md\" style=\"margin-bottom:10px\">Widget Pro - 30 days</div>\n    <svg width=\"100%\" height=\"260\" viewBox=\"0 0 1500 260\" preserveAspectRatio=\"none\" fill=\"none\">\n      <defs><linearGradient id=\"gA\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"var(--accent)\" stop-opacity=\".4\"/><stop offset=\"1\" stop-color=\"var(--accent)\" stop-opacity=\"0\"/></linearGradient></defs>\n      <path class=\"area\" d=\"M0 60 L180 70 L360 50 L540 90 L720 80 L900 150 L1080 140 L1260 200 L1500 190 L1500 260 L0 260Z\" fill=\"url(#gA)\"/>\n      <path class=\"line\" d=\"M0 60 L180 70 L360 50 L540 90 L720 80 L900 150 L1080 140 L1260 200 L1500 190\" stroke=\"var(--accent2)\" stroke-width=\"6\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>\n      <g class=\"mk\"><circle cx=\"1260\" cy=\"200\" r=\"22\" fill=\"var(--good)\" opacity=\".3\"/><circle cx=\"1260\" cy=\"200\" r=\"10\" fill=\"var(--good)\"/></g></svg></div>\n</div>",
    "js": "\nconst q=s=>box.querySelector(s);\nH.stagger(c,[q('.k1'),q('.k2'),q('.k3')],[{opacity:0,transform:'translateY(30px)'},{opacity:1,transform:'none'}],.4,.2,.6);\nH.count(c,q('.v1'),12,.8,1.2); H.count(c,q('.v2'),1248,1.0,1.6); H.count(c,q('.v3'),37,1.2,1.6);\nc.a(q('.ch'),[{opacity:0,transform:'translateY(30px)'},{opacity:1,transform:'none'}],1.4,.6);\nH.draw(c,q('.line'),2.0,2.0); c.a(q('.area'),[{opacity:0},{opacity:1}],2.6,1.6);\nc.a(q('.mk'),[{opacity:0,transform:'scale(.3)'},{opacity:1,transform:'scale(1)'}],4.0,.5,'cubic-bezier(.3,1.5,.5,1)');\nH.loop(c,1.4,4.0,u=>{q('.mk').style.opacity=.55+.45*Math.sin(u*Math.PI*2)});\n"
   }
  }
 ]
}